# مواجهة الوحوش — متغيّرات البيئة
#
# اللعبة تعمل بالكامل بلا أي من هذه: اللعب ضد الخصم الآلي والتعليم واللعب
# على جهاز واحد ووضع البقاء لا تحتاج شبكة أصلاً. المفاتيح تفتح اللعب
# الجماعي والحسابات والسجل.

# ── مطلوبة للّعب الجماعي والحسابات (عامّة، تظهر في المتصفّح) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>

# ── مطلوب لإنشاء الحسابات فقط (سرّي، على الخادم وحده) ──
# مسار /api/auth/register ينادي auth.admin به. لا تضعه في متغيّر NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── اختياري: يتجاوز NEXT_PUBLIC_SUPABASE_URL على الخادم ──
# SUPABASE_URL=https://<project-ref>.supabase.co
